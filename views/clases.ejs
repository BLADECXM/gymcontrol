<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="mb-0"><i class="bi bi-calendar-week text-primary"></i> Clases y Horarios</h4>
        <div class="d-flex gap-2">
            <% if (usuario.rol === 'Administrador' || usuario.rol === 'Recepcionista') { %>
                <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalInscribir">
                    <i class="bi bi-person-plus"></i> Inscribir Atleta
                </button>
            <% } %>
            <% if (usuario.rol === 'Administrador') { %>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevaClase">
                    <i class="bi bi-plus-circle"></i> Nueva Clase
                </button>
            <% } %>
        </div>
    </div>

    <% if (mensaje) { %>
        <div class="alert alert-success alert-dismissible fade show py-2">
            <%= mensaje %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show py-2">
            <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Tarjetas de Clases -->
    <div class="row g-3">
        <% if (clases.length === 0) { %>
            <div class="col-12">
                <div class="card border-0 shadow-sm p-4 text-center text-muted">
                    No hay clases programadas todavía. Crea una clase como Zumba, CrossFit o Spinning.
                </div>
            </div>
        <% } %>

        <% clases.forEach(c => { 
            const porcentaje = Math.min(100, Math.round((c.inscritos / c.cupo_maximo) * 100));
            const barraColor = porcentaje >= 100 ? 'bg-danger' : (porcentaje >= 75 ? 'bg-warning' : 'bg-success');
        %>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0"><%= c.nombre_clase %></h5>
                            <span class="badge bg-dark"><%= c.dia_semana %></span>
                        </div>

                        <p class="text-muted small mb-1">
                            <i class="bi bi-clock"></i> <%= c.hora_inicio.slice(0,5) %> - <%= c.hora_fin.slice(0,5) %>
                        </p>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-person-badge"></i> Entrenador: <strong><%= c.entrenador_nombre %></strong>
                        </p>

                        <!-- Barra de ocupación de cupos -->
                        <div class="mb-3 mt-auto">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Cupos ocupados</span>
                                <span class="fw-bold"><%= c.inscritos %> / <%= c.cupo_maximo %></span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar <%= barraColor %>" style="width: <%= porcentaje %>%;"></div>
                            </div>
                        </div>

                        <a href="/clases/<%= c.id_clase %>/asistencia" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-list-check"></i> Ver Inscritos / Tomar Asistencia
                        </a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<!-- Modal Nueva Clase (Solo Admin) -->
<div class="modal fade" id="modalNuevaClase" tabindex="-1">
    <div class="modal-dialog">
        <form action="/clases/crear" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crear Nueva Clase</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre de la Clase *</label>
                    <input type="text" name="nombre_clase" class="form-control" placeholder="Ej: Zumba, CrossFit, Spinning" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Entrenador Responsable</label>
                    <select name="id_entrenador" class="form-select">
                        <option value="">-- Sin asignar --</option>
                        <% entrenadores.forEach(e => { %>
                            <option value="<%= e.id_usuario %>"><%= e.nombre_completo %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Día de la Semana *</label>
                    <select name="dia_semana" class="form-select" required>
                        <option value="Lunes">Lunes</option>
                        <option value="Martes">Martes</option>
                        <option value="Miércoles">Miércoles</option>
                        <option value="Jueves">Jueves</option>
                        <option value="Viernes">Viernes</option>
                        <option value="Sábado">Sábado</option>
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Hora Inicio *</label>
                        <input type="time" name="hora_inicio" class="form-control" required>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Hora Fin *</label>
                        <input type="time" name="hora_fin" class="form-control" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Cupo Máximo *</label>
                    <input type="number" name="cupo_maximo" min="1" value="20" class="form-control" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Clase</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Inscribir Atleta -->
<div class="modal fade" id="modalInscribir" tabindex="-1">
    <div class="modal-dialog">
        <form action="/clases/inscribir" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Inscribir Atleta a Clase</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Clase *</label>
                    <select name="id_clase" class="form-select" required>
                        <option value="">-- Seleccione una clase --</option>
                        <% clases.forEach(c => { %>
                            <option value="<%= c.id_clase %>">
                                <%= c.nombre_clase %> - <%= c.dia_semana %> <%= c.hora_inicio.slice(0,5) %> (<%= c.inscritos %>/<%= c.cupo_maximo %>)
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Miembro / Atleta *</label>
                    <select name="id_miembro" class="form-select" required>
                        <option value="">-- Seleccione un atleta --</option>
                        <% miembros.forEach(m => { %>
                            <option value="<%= m.id_miembro %>"><%= m.nombre_completo %> (<%= m.dni %>)</option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-success">Confirmar Inscripción</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
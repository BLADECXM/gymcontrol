<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="mb-0"><i class="bi bi-tags-fill text-primary"></i> Planes y Tarifas</h4>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoPlan">
            <i class="bi bi-plus-circle"></i> Nuevo Plan
        </button>
    </div>

    <% if (mensaje) { %>
        <div class="alert alert-success alert-dismissible fade show py-2"><%= mensaje %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show py-2"><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre del Plan</th>
                        <th>Precio (L.)</th>
                        <th>Duración</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% planes.forEach(p => { %>
                        <tr>
                            <td class="fw-semibold"><%= p.nombre_plan %></td>
                            <td>L. <%= parseFloat(p.precio_lempiras).toFixed(2) %></td>
                            <td><%= p.duracion_dias %> días</td>
                            <td>
                                <span class="badge <%= p.activo ? 'bg-success' : 'bg-secondary' %>">
                                    <%= p.activo ? 'Activo' : 'Inactivo' %>
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"
                                    data-id="<%= p.id_plan %>"
                                    data-nombre="<%= p.nombre_plan %>"
                                    data-precio="<%= p.precio_lempiras %>"
                                    data-dias="<%= p.duracion_dias %>"
                                    onclick="abrirEditarPlan(this)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form action="/planes/estado/<%= p.id_plan %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm <%= p.activo ? 'btn-outline-danger' : 'btn-outline-success' %>">
                                        <i class="bi <%= p.activo ? 'bi-toggle-off' : 'bi-toggle-on' %>"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nuevo Plan -->
<div class="modal fade" id="modalNuevoPlan" tabindex="-1">
    <div class="modal-dialog">
        <form action="/planes/crear" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo Plan de Membresía</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre del Plan *</label>
                    <input type="text" name="nombre_plan" class="form-control" placeholder="Ej: Semanal, Mensual VIP" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Precio en Lempiras (L.) *</label>
                    <input type="number" step="0.01" min="0" name="precio_lempiras" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Duración en Días *</label>
                    <input type="number" min="1" name="duracion_dias" class="form-control" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Plan -->
<div class="modal fade" id="modalEditarPlan" tabindex="-1">
    <div class="modal-dialog">
        <form id="formEditarPlan" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Plan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre del Plan *</label>
                    <input type="text" id="edit_plan_nombre" name="nombre_plan" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Precio en Lempiras (L.) *</label>
                    <input type="number" step="0.01" min="0" id="edit_plan_precio" name="precio_lempiras" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Duración en Días *</label>
                    <input type="number" min="1" id="edit_plan_dias" name="duracion_dias" class="form-control" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function abrirEditarPlan(btn) {
        document.getElementById('formEditarPlan').action = '/planes/editar/' + btn.dataset.id;
        document.getElementById('edit_plan_nombre').value = btn.dataset.nombre;
        document.getElementById('edit_plan_precio').value = btn.dataset.precio;
        document.getElementById('edit_plan_dias').value = btn.dataset.dias;
        new bootstrap.Modal(document.getElementById('modalEditarPlan')).show();
    }
</script>
</body>
</html>
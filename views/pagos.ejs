<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="mb-0"><i class="bi bi-cash-coin text-success"></i> Cobros y Renovaciones</h4>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalNuevoPago">
            <i class="bi bi-plus-circle"></i> Registrar Cobro
        </button>
    </div>

    <% if (mensaje) { %>
        <div class="alert alert-success alert-dismissible fade show py-2">
            <%= mensaje %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show py-2">
            <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Recibo</th>
                        <th>Miembro</th>
                        <th>Plan</th>
                        <th>Monto</th>
                        <th>Vigencia</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (pagos.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No hay pagos registrados todavía.</td>
                        </tr>
                    <% } %>
                    <% pagos.forEach(p => { %>
                        <tr class="<%= p.anulado ? 'table-secondary text-muted' : '' %>">
                            <td class="fw-bold"><%= p.codigo_recibo %></td>
                            <td>
                                <%= p.miembro_nombre %><br>
                                <small class="text-muted"><%= p.dni %></small>
                            </td>
                            <td><%= p.nombre_plan %> (<%= p.metodo_pago %>)</td>
                            <td class="fw-semibold">L. <%= parseFloat(p.monto_pagado).toFixed(2) %></td>
                            <td>
                                <small>
                                    <%= new Date(p.fecha_inicio).toLocaleDateString('es-HN') %> -
                                    <strong><%= new Date(p.fecha_vencimiento).toLocaleDateString('es-HN') %></strong>
                                </small>
                            </td>
                            <td>
                                <% if (p.anulado) { %>
                                    <span class="badge bg-danger">Anulado</span>
                                <% } else { %>
                                    <span class="badge bg-success">Pagado</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <a href="/pagos/voucher/<%= p.id_pago %>" target="_blank" class="btn btn-sm btn-outline-dark" title="Ver Voucher PDF">
                                    <i class="bi bi-file-earmark-pdf-fill text-danger"></i> PDF
                                </a>
                                <% if (!p.anulado && usuario.rol === 'Administrador') { %>
                                    <button class="btn btn-sm btn-outline-danger"
                                        data-id="<%= p.id_pago %>"
                                        data-recibo="<%= p.codigo_recibo %>"
                                        onclick="abrirAnular(this)" title="Anular cobro">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nuevo Cobro -->
<div class="modal fade" id="modalNuevoPago" tabindex="-1">
    <div class="modal-dialog">
        <form action="/pagos/crear" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Cobro / Renovación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Seleccionar Miembro *</label>
                    <select name="id_miembro" class="form-select" required>
                        <option value="">-- Seleccione un atleta --</option>
                        <% miembros.forEach(m => { %>
                            <option value="<%= m.id_miembro %>"><%= m.nombre_completo %> (<%= m.dni %>)</option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Plan de Membresía *</label>
                    <select name="id_plan" class="form-select" required>
                        <option value="">-- Seleccione un plan --</option>
                        <% planes.forEach(pl => { %>
                            <option value="<%= pl.id_plan %>">
                                <%= pl.nombre_plan %> - L. <%= parseFloat(pl.precio_lempiras).toFixed(2) %> (<%= pl.duracion_dias %> días)
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Método de Pago *</label>
                    <select name="metodo_pago" class="form-select" required>
                        <option value="Efectivo">Efectivo</option>
                        <option value="Tarjeta">Tarjeta</option>
                        <option value="Transferencia">Transferencia</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-success">Registrar Pago</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Anular Cobro -->
<div class="modal fade" id="modalAnular" tabindex="-1">
    <div class="modal-dialog">
        <form id="formAnular" method="POST" class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Anular Recibo <span id="spanRecibo"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Esta acción revertirá la vigencia de este pago en el sistema.</p>
                <div class="mb-3">
                    <label class="form-label">Motivo de anulación *</label>
                    <input type="text" name="motivo_anulacion" class="form-control" placeholder="Ej: Error de cobro / duplicado" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger">Confirmar Anulación</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function abrirAnular(btn) {
        document.getElementById('formAnular').action = '/pagos/anular/' + btn.dataset.id;
        document.getElementById('spanRecibo').textContent = btn.dataset.recibo;
        new bootstrap.Modal(document.getElementById('modalAnular')).show();
    }
</script>
</body>
</html>
<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container mt-4">
    <h4 class="mb-3"><i class="bi bi-qr-code-scan text-primary"></i> Control de Acceso (Check-in Diario)</h4>

    <!-- Formulario de búsqueda por DNI -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form action="/checkin/validar" method="POST" class="row g-2 align-items-center">
                <div class="col-md-8">
                    <input type="text" name="dni" class="form-control form-control-lg"
                        placeholder="Ingrese o escanee el DNI del miembro..." autofocus required>
                </div>
                <div class="col-md-4 d-grid">
                    <button type="submit" class="btn btn-dark btn-lg">
                        <i class="bi bi-check2-circle"></i> Validar Acceso
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Error si el DNI no existe -->
    <% if (error) { %>
        <div class="alert alert-warning shadow-sm d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div><%= error %></div>
        </div>
    <% } %>

    <!-- ALERTA VISUAL GRANDE (VERDE = PERMITIDO / ROJO = DENEGADO) -->
    <% if (resultado) { %>
        <div class="card border-0 shadow mb-4 text-white <%= resultado.accesoPermitido ? 'bg-success' : 'bg-danger' %>">
            <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi <%= resultado.accesoPermitido ? 'bi-check-circle-fill' : 'bi-x-octagon-fill' %>" style="font-size: 3.5rem;"></i>
                    <div>
                        <h3 class="fw-bold mb-1">
                            <%= resultado.accesoPermitido ? 'ACCESO PERMITIDO' : 'ACCESO DENEGADO' %>
                        </h3>
                        <h5 class="mb-1"><%= resultado.miembro.nombre_completo %> (<%= resultado.miembro.dni %>)</h5>
                        <p class="mb-0">
                            <strong>Plan:</strong> <%= resultado.nombrePlan %> |
                            <strong>Estado:</strong> <%= resultado.detalleEstado %>
                        </p>
                    </div>
                </div>

                <% if (!resultado.accesoPermitido) { %>
                    <a href="/pagos" class="btn btn-light text-danger fw-bold">
                        <i class="bi bi-cash-coin"></i> Ir a Renovar Membresía
                    </a>
                <% } %>
            </div>
        </div>
    <% } %>

    <!-- Historial de Check-ins de Hoy -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white fw-bold">
            <i class="bi bi-clock-history"></i> Ingresos registrados hoy (<%= checkinsHoy.length %>)
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Hora</th>
                        <th>DNI</th>
                        <th>Miembro</th>
                        <th>Resultado</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (checkinsHoy.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Aún no hay check-ins registrados hoy.</td>
                        </tr>
                    <% } %>
                    <% checkinsHoy.forEach(c => { %>
                        <tr>
                            <td><%= new Date(c.fecha_hora).toLocaleTimeString('es-HN', { hour: '2-digit', minute: '2-digit' }) %></td>
                            <td class="fw-semibold"><%= c.dni %></td>
                            <td><%= c.nombre_completo %></td>
                            <td>
                                <span class="badge <%= c.acceso_permitido ? 'bg-success' : 'bg-danger' %>">
                                    <%= c.acceso_permitido ? 'Permitido' : 'Denegado' %>
                                </span>
                            </td>
                            <td class="small text-muted"><%= c.detalle_estado %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<% 
  const currentUser = typeof user !== 'undefined' ? user : (typeof usuario !== 'undefined' ? usuario : null);
  const rol = currentUser ? currentUser.rol : ''; 
  const homeUrl = rol === 'Entrenador' ? '/clases' : (rol === 'Cliente' ? '/mi-portal' : '/');
%>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/dashboard">
            <i class="bi bi-activity text-warning"></i> GymControl
        </a>
        <!-- Botón Menú Hamburguesa para móviles -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuGym">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuGym">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
  <% if (rol === 'Administrador' || rol === 'Recepcionista') { %>
    <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
    <li class="nav-item"><a class="nav-link" href="/checkin">Check-in</a></li>
    <li class="nav-item"><a class="nav-link" href="/miembros">Miembros</a></li>
    <li class="nav-item"><a class="nav-link" href="/pagos">Pagos</a></li>
    <li class="nav-item"><a class="nav-link" href="/clases">Clases</a></li>
    <li class="nav-item"><a class="nav-link" href="/caja">Caja</a></li>
  <% } %>

  <% if (rol === 'Administrador') { %>
    <li class="nav-item"><a class="nav-link" href="/planes">Planes</a></li>
    <li class="nav-item"><a class="nav-link" href="/usuarios">Usuarios</a></li>
    <li class="nav-item"><a class="nav-link" href="/seguimiento">Seguimiento</a></li>
    <li class="nav-item"><a class="nav-link" href="/reportes">Reportes</a></li>
  <% } %>

  <% if (rol === 'Entrenador') { %>
    <li class="nav-item"><a class="nav-link" href="/clases">Mis Clases</a></li>
    <li class="nav-item"><a class="nav-link" href="/seguimiento">Seguimiento y Rutinas</a></li>
  <% } %>

  <% if (rol === 'Cliente') { %>
    <li class="nav-item"><a class="nav-link" href="/mi-portal">Mi Portal</a></li>
  <% } %>
</ul>
            <% if (usuario) { %>
                <div class="d-flex align-items-center text-white gap-3">
                    <small><i class="bi bi-person-circle"></i> <%= usuario.nombre %> (<%= usuario.rol %>)</small>
                    <a href="/logout" class="btn btn-outline-danger btn-sm">Salir</a>
                </div>
            <% } %>
        </div>
    </div>
</nav>
<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <h2 class="fw-bold mb-0">Seguimiento Físico y Rutinas</h2>
      <small class="text-muted">Evaluaciones corporales, prevención de lesiones y planes de entrenamiento</small>
    </div>
  </div>

  <% if (mensaje) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= mensaje %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Selector de Miembro -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <form method="GET" action="/seguimiento" class="row g-3 align-items-end">
        <div class="col-md-9">
          <label for="miembro" class="form-label fw-semibold">Seleccionar Atleta / Miembro</label>
          <select name="miembro" id="miembro" class="form-select" required>
            <option value="">-- Elige un miembro para ver o registrar seguimiento --</option>
            <% miembros.forEach(m => { %>
              <option value="<%= m.id_miembro %>" <%= miembroActual && miembroActual.id_miembro === m.id_miembro ? 'selected' : '' %>>
                <%= m.nombre_completo %> — DNI: <%= m.dni %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <button type="submit" class="btn btn-primary w-100">Cargar Ficha</button>
        </div>
      </form>
    </div>
  </div>

  <% if (miembroActual) { %>
    <!-- Tarjetas de Resumen del Atleta -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <small class="text-muted text-uppercase">Peso Actual</small>
            <h3 class="fw-bold mb-0"><%= resumenProgreso ? resumenProgreso.pesoActual + ' kg' : 'Sin registro' %></h3>
            <% if (resumenProgreso && resumenProgreso.diferenciaPeso !== null) { %>
              <% const diff = parseFloat(resumenProgreso.diferenciaPeso); %>
              <small class="<%= diff <= 0 ? 'text-success' : 'text-primary' %> fw-semibold">
                <%= diff > 0 ? '+' : '' %><%= resumenProgreso.diferenciaPeso %> kg desde inicio
              </small>
            <% } %>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <small class="text-muted text-uppercase">IMC Actual</small>
            <h3 class="fw-bold mb-0"><%= resumenProgreso ? resumenProgreso.imcActual : '-' %></h3>
            <small class="text-muted">Calculado automáticamente</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <small class="text-muted text-uppercase">% Grasa Corporal</small>
            <h3 class="fw-bold mb-0"><%= resumenProgreso ? resumenProgreso.grasaActual : '-' %></h3>
            <small class="text-muted"><%= resumenProgreso ? resumenProgreso.totalEvaluaciones : 0 %> evaluación(es)</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <small class="text-muted text-uppercase">Objetivo Activo</small>
            <h5 class="fw-bold mb-1 mt-1"><%= rutinaActiva ? rutinaActiva.objetivo : 'Sin asignar' %></h5>
            <span class="badge bg-info text-dark"><%= rutinaActiva ? rutinaActiva.nivel : 'Pendiente' %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <!-- Columna Izquierda: Formularios de Registro -->
      <div class="col-lg-5">
        <!-- Form Nueva Evaluación -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-dark text-white fw-semibold">
            Registrar Evaluación Física
          </div>
          <div class="card-body">
            <form method="POST" action="/seguimiento/evaluacion">
              <input type="hidden" name="id_miembro" value="<%= miembroActual.id_miembro %>">
              <div class="row g-2 mb-2">
                <div class="col-6">
                  <label class="form-label small fw-semibold">Fecha</label>
                  <input type="date" name="fecha_evaluacion" class="form-control form-control-sm" value="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                <div class="col-6">
                  <label class="form-label small fw-semibold">Peso (kg) *</label>
                  <input type="number" step="0.01" name="peso_kg" class="form-control form-control-sm" required placeholder="Ej. 78.5">
                </div>
              </div>
              <div class="row g-2 mb-2">
                <div class="col-4">
                  <label class="form-label small fw-semibold">Estatura (cm)</label>
                  <input type="number" step="0.1" name="estatura_cm" class="form-control form-control-sm" placeholder="Ej. 175">
                </div>
                <div class="col-4">
                  <label class="form-label small fw-semibold">% Grasa</label>
                  <input type="number" step="0.1" name="porcentaje_grasa" class="form-control form-control-sm" placeholder="Ej. 18.5">
                </div>
                <div class="col-4">
                  <label class="form-label small fw-semibold">Cintura (cm)</label>
                  <input type="number" step="0.1" name="cintura_cm" class="form-control form-control-sm" placeholder="Ej. 84">
                </div>
              </div>
              <div class="mb-2">
                <label class="form-label small fw-semibold">Observaciones de Técnica / Progreso</label>
                <textarea name="observaciones_tecnica" rows="2" class="form-control form-control-sm" placeholder="Ej. Mejoró postura en sentadilla, subir carga gradualmente..."></textarea>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-semibold text-danger">Alertas / Lesiones a Prevenir</label>
                <textarea name="lesiones_alertas" rows="2" class="form-control form-control-sm" placeholder="Ej. Molestia leve en rodilla derecha, evitar impacto alto..."></textarea>
              </div>
              <button type="submit" class="btn btn-success btn-sm w-100 fw-semibold">Guardar Evaluación</button>
            </form>
          </div>
        </div>

        <!-- Form Rutina Activa -->
        <div class="card shadow-sm">
          <div class="card-header bg-primary text-white fw-semibold">
            Asignar / Actualizar Rutina
          </div>
          <div class="card-body">
            <form method="POST" action="/seguimiento/rutina">
              <input type="hidden" name="id_miembro" value="<%= miembroActual.id_miembro %>">
              <div class="row g-2 mb-2">
                <div class="col-7">
                  <label class="form-label small fw-semibold">Objetivo *</label>
                  <input type="text" name="objetivo" class="form-control form-control-sm" required
                         value="<%= rutinaActiva ? rutinaActiva.objetivo : '' %>"
                         placeholder="Ej. Pérdida de grasa / Hipertrofia">
                </div>
                <div class="col-5">
                  <label class="form-label small fw-semibold">Nivel</label>
                  <select name="nivel" class="form-select form-select-sm">
                    <option value="Principiante" <%= rutinaActiva && rutinaActiva.nivel === 'Principiante' ? 'selected' : '' %>>Principiante</option>
                    <option value="Intermedio" <%= !rutinaActiva || rutinaActiva.nivel === 'Intermedio' ? 'selected' : '' %>>Intermedio</option>
                    <option value="Avanzado" <%= rutinaActiva && rutinaActiva.nivel === 'Avanzado' ? 'selected' : '' %>>Avanzado</option>
                  </select>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-semibold">Detalle de la Rutina Semanal *</label>
                <textarea name="detalle_rutina" rows="6" class="form-control form-control-sm" required
                          placeholder="Lunes (Empuje): Press banca 4x10...&#10;Miércoles (Pierna): Sentadilla 4x8..."><%= rutinaActiva ? rutinaActiva.detalle_rutina : '' %></textarea>
              </div>
              <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Guardar Nueva Rutina</button>
            </form>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Rutina Actual e Historial -->
      <div class="col-lg-7">
        <!-- Vista rápida de Rutina Activa -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
            <span>Rutina Actual Asignada</span>
            <% if (rutinaActiva) { %>
              <small class="text-muted">Por <%= rutinaActiva.entrenador_nombre %></small>
            <% } %>
          </div>
          <div class="card-body">
            <% if (rutinaActiva) { %>
              <p class="mb-2">
                <strong>Objetivo:</strong> <%= rutinaActiva.objetivo %>
                <span class="badge bg-primary ms-2"><%= rutinaActiva.nivel %></span>
              </p>
              <pre class="bg-light p-3 rounded border mb-0" style="white-space: pre-wrap; font-family: inherit;"><%= rutinaActiva.detalle_rutina %></pre>
            <% } else { %>
              <p class="text-muted mb-0">Este miembro todavía no tiene una rutina asignada.</p>
            <% } %>
          </div>
        </div>

        <!-- Historial de Evaluaciones Físicas -->
        <div class="card shadow-sm">
          <div class="card-header bg-light fw-semibold">
            Historial de Evaluaciones Físicas
          </div>
          <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th>Fecha</th>
                  <th>Peso</th>
                  <th>IMC</th>
                  <th>% Grasa</th>
                  <th>Cintura</th>
                  <th>Notas / Lesiones</th>
                </tr>
              </thead>
              <tbody>
                <% if (evaluaciones.length === 0) { %>
                  <tr>
                    <td colspan="6" class="text-center text-muted py-3">Sin evaluaciones registradas aún.</td>
                  </tr>
                <% } else { %>
                  <% evaluaciones.forEach(e => { %>
                    <tr>
                      <td class="text-nowrap"><%= new Date(e.fecha_evaluacion).toLocaleDateString('es-HN') %></td>
                      <td class="fw-bold"><%= e.peso_kg %> kg</td>
                      <td><%= e.imc || '-' %></td>
                      <td><%= e.porcentaje_grasa ? e.porcentaje_grasa + '%' : '-' %></td>
                      <td><%= e.cintura_cm ? e.cintura_cm + ' cm' : '-' %></td>
                      <td class="small">
                        <% if (e.observaciones_tecnica) { %>
                          <div><strong>Técnica:</strong> <%= e.observaciones_tecnica %></div>
                        <% } %>
                        <% if (e.lesiones_alertas) { %>
                          <div class="text-danger"><strong>Alerta:</strong> <%= e.lesiones_alertas %></div>
                        <% } %>
                        <div class="text-muted" style="font-size: 0.75rem;">Evaluó: <%= e.entrenador_nombre %></div>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<%- include('partials/header') %>
<div class="d-print-none">
    <%- include('partials/navbar') %>
</div>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0"><i class="bi bi-pie-chart-fill text-primary"></i> Reportes y Analítica Mensual</h4>
            <small class="text-muted">Comportamiento del periodo: <strong><%= mes %></strong> (<%= desde %> al <%= hasta %>)</small>
        </div>
        <div class="d-flex gap-2 d-print-none">
            <form method="GET" action="/reportes" class="d-flex gap-2">
                <input type="month" name="mes" class="form-control" value="<%= mes %>" required>
                <button type="submit" class="btn btn-dark"><i class="bi bi-funnel"></i> Ver Mes</button>
            </form>
            <button onclick="window.print()" class="btn btn-danger">
                <i class="bi bi-file-earmark-pdf-fill"></i> PDF
            </button>
            <button onclick="window.print()" class="btn btn-success">
            <a href="/reportes/exportar-excel?mes=<%= mes %>" class="btn btn-success">
                <i class="bi bi-file-earmark-excel-fill"></i> Excel
                </a>
            </button>
        </div>
    </div>

    <!-- Tarjetas KPI del Mes -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body">
                    <small class="text-white-50">Miembros Activos</small>
                    <h3 class="fw-bold mb-0"><%= kpis.totalMiembros %></h3>
                    <small>+<%= kpis.nuevosMes %> nuevos este mes</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body">
                    <small class="text-white-50">Ingresos del Mes</small>
                    <h3 class="fw-bold mb-0">L. <%= kpis.totalIngresos %></h3>
                    <small><%= pagos.length %> pagos registrados</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm bg-dark text-white h-100">
                <div class="card-body">
                    <small class="text-white-50">Visitas (Check-ins)</small>
                    <h3 class="fw-bold mb-0"><%= kpis.checkinsMes %></h3>
                    <small>Accesos permitidos en el mes</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body">
                    <small class="fw-semibold">Por Vencer (7 días)</small>
                    <h3 class="fw-bold mb-0"><%= vencimientos.length %></h3>
                    <small>Atletas por renovar</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 1 de Gráficos: Jornada (Pastel) y Edades (Barras) -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-sun-fill text-warning"></i> Asistencia por Jornada (Día vs. Noche)
                </div>
                <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 280px;">
                    <canvas id="chartJornada"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-people-fill text-primary"></i> Edades que más asisten al gimnasio
                </div>
                <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 280px;">
                    <canvas id="chartEdades"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 2 de Gráficos: Ingresos por Plan (Barras) y Métodos de Pago (Pastel) -->
    <div class="row g-4 mb-4">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-bar-chart-fill text-success"></i> Ingresos del Mes por Plan (L.)
                </div>
                <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 280px;">
                    <canvas id="chartIngresosPlan"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-credit-card-fill text-info"></i> Métodos de Pago Utilizados
                </div>
                <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 280px;">
                    <canvas id="chartMetodosPago"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Resumen: Membresías Próximas a Vencer -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-warning text-dark fw-bold">
            Membresías Vencidas o Próximas a Vencer (<%= vencimientos.length %>)
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>DNI</th>
                        <th>Miembro</th>
                        <th>Teléfono</th>
                        <th>Vencimiento</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (vencimientos.length === 0) { %>
                        <tr><td colspan="4" class="text-center text-muted py-3">Sin vencimientos próximos.</td></tr>
                    <% } %>
                    <% vencimientos.forEach(v => { %>
                        <tr>
                            <td><%= v.dni %></td>
                            <td><%= v.nombre_completo %></td>
                            <td><%= v.telefono || '-' %></td>
                            <td class="fw-bold text-danger"><%= new Date(v.ultima_fecha_vencimiento).toLocaleDateString('es-HN') %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tabla Detalle de Pagos del Mes -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between">
            <span>Detalle de Ingresos del Mes (<%= pagos.length %>)</span>
            <strong>Total: L. <%= kpis.totalIngresos %></strong>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Recibo</th>
                        <th>Miembro</th>
                        <th>Plan</th>
                        <th>Método</th>
                        <th class="text-end">Monto</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (pagos.length === 0) { %>
                        <tr><td colspan="6" class="text-center text-muted py-3">Sin pagos en este mes.</td></tr>
                    <% } %>
                    <% pagos.forEach(p => { %>
                        <tr>
                            <td><%= new Date(p.fecha_pago).toLocaleDateString('es-HN') %></td>
                            <td><%= p.codigo_recibo %></td>
                            <td><%= p.miembro %></td>
                            <td><%= p.nombre_plan %></td>
                            <td><%= p.metodo_pago %></td>
                            <td class="text-end fw-semibold">L. <%= parseFloat(p.monto_pagado).toFixed(2) %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Datos JSON seguros para Chart.js -->
<script id="datos-graficos" type="application/json"><%- JSON.stringify(graficos) %></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const datos = JSON.parse(document.getElementById('datos-graficos').textContent);

    // 1. Gráfico de Pastel: Jornada (Mañana / Tarde / Noche)
    new Chart(document.getElementById('chartJornada'), {
        type: 'pie',
        data: {
            labels: datos.jornada.labels.length ? datos.jornada.labels : ['Sin datos'],
            datasets: [{
                data: datos.jornada.data.length ? datos.jornada.data : [1],
                backgroundColor: ['#ffc107', '#0d6efd', '#212529']
            }]
        },
        options: { responsive: true, maintainAspectRatio: false }
    });

    // 2. Gráfico de Barras: Edades que más asisten
    new Chart(document.getElementById('chartEdades'), {
        type: 'bar',
        data: {
            labels: datos.edades.labels,
            datasets: [{
                label: 'Visitas (Check-ins)',
                data: datos.edades.data,
                backgroundColor: '#0d6efd',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    // 3. Gráfico de Barras: Ingresos por Plan
    new Chart(document.getElementById('chartIngresosPlan'), {
        type: 'bar',
        data: {
            labels: datos.ingresosPlan.labels,
            datasets: [{
                label: 'Ingresos (L.)',
                data: datos.ingresosPlan.data,
                backgroundColor: '#198754',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { beginAtZero: true } }
        }
    });

    // 4. Gráfico de Pastel (Dona): Métodos de Pago
    new Chart(document.getElementById('chartMetodosPago'), {
        type: 'doughnut',
        data: {
            labels: datos.metodosPago.labels.length ? datos.metodosPago.labels : ['Sin datos'],
            datasets: [{
                data: datos.metodosPago.data.length ? datos.metodosPago.data : [1],
                backgroundColor: ['#198754', '#0dcaf0', '#6f42c1']
            }]
        },
        options: { responsive: true, maintainAspectRatio: false }
    });
</script>
</body>
</html>
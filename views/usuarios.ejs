<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="mb-0"><i class="bi bi-shield-lock-fill text-primary"></i> Usuarios y Roles</h4>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoUsuario">
            <i class="bi bi-person-plus"></i> Nuevo Usuario
        </button>
    </div>

    <% if (mensaje) { %>
        <div class="alert alert-success alert-dismissible fade show py-2"><%= mensaje %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show py-2"><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Teléfono / Especialidad</th>
                        <th>Estado</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <% usuarios.forEach(u => { %>
                        <tr>
                            <td class="fw-bold text-primary"><%= u.codigo_usuario || '-' %></td>
                            <td class="fw-semibold"><%= u.nombre_completo %></td>
                            <td><%= u.correo %></td>
                            <td><span class="badge bg-info text-dark"><%= u.nombre_rol %></span></td>
                            <td class="small text-muted">
                                <%= u.telefono || '-' %>
                                <% if (u.especialidad) { %> | <strong><%= u.especialidad %></strong><% } %>
                            </td>
                            <td>
                                <span class="badge <%= u.activo ? 'bg-success' : 'bg-secondary' %>">
                                    <%= u.activo ? 'Activo' : 'Inactivo' %>
                                </span>
                            </td>
                            <td class="text-end">
                                <% if (u.id_usuario !== usuario.id) { %>
                                    <form action="/usuarios/estado/<%= u.id_usuario %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm <%= u.activo ? 'btn-outline-danger' : 'btn-outline-success' %>">
                                            <%= u.activo ? 'Desactivar' : 'Activar' %>
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-muted small">Tu cuenta</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nuevo Usuario -->
<div class="modal fade" id="modalNuevoUsuario" tabindex="-1">
    <div class="modal-dialog">
        <form action="/usuarios/crear" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crear Usuario del Sistema</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-light border small py-2 mb-3">
                    <i class="bi bi-key-fill text-primary"></i> El código de acceso (<code>GC-XXXX</code>) se generará automáticamente al guardar.
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombre Completo *</label>
                    <input type="text" name="nombre_completo" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Correo Electrónico *</label>
                    <input type="email" name="correo" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña *</label>
                    <input type="password" name="clave" class="form-control" minlength="6" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Rol *</label>
                    <select name="id_rol" class="form-select" required>
                        <% roles.forEach(r => { %>
                            <option value="<%= r.id_rol %>"><%= r.nombre_rol %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Teléfono (Opcional)</label>
                    <input type="text" name="telefono" class="form-control" placeholder="Ej: 50499998888">
                </div>
                <div class="mb-3">
                    <label class="form-label">Especialidad (Solo Entrenadores)</label>
                    <input type="text" name="especialidad" class="form-control" placeholder="Ej: Zumba, Pesas, CrossFit">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Usuario</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
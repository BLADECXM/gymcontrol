<%- include('partials/header') %>

<!-- Navbar exclusivo del Cliente -->
<nav class="navbar navbar-dark bg-dark shadow-sm">
    <div class="container">
        <span class="navbar-brand fw-bold">
            <i class="bi bi-activity text-warning"></i> GymControl <small class="fw-normal text-white-50">| Mi Portal</small>
        </span>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white small d-none d-sm-inline">
                <i class="bi bi-person-circle"></i> <%= usuario.nombre %>
            </span>
            <a href="/logout" class="btn btn-outline-light btn-sm">
                <i class="bi bi-box-arrow-right"></i> Salir
            </a>
        </div>
    </div>
</nav>

<div class="container mt-4 mb-5">
    <% if (error) { %>
        <div class="alert alert-warning shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        </div>
    <% } else { %>

        <!-- Tarjeta de Estado de Membresía -->
        <div class="card border-0 shadow mb-4 text-white <%= estadoMembresia.vigente ? 'bg-success' : 'bg-danger' %>">
            <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <small class="text-uppercase opacity-75">Estado de Membresía</small>
                    <h3 class="fw-bold mb-1">
                        <%= estadoMembresia.vigente ? 'MEMBRESÍA ACTIVA' : 'MEMBRESÍA VENCIDA / INACTIVA' %>
                    </h3>
                    <p class="mb-0">
                        <strong>Plan:</strong> <%= estadoMembresia.plan %>
                        <% if (estadoMembresia.vence) { %>
                            | <strong>Vence:</strong> <%= estadoMembresia.vence %>
                        <% } %>
                    </p>
                </div>
                <div class="text-end">
                    <% if (estadoMembresia.vigente) { %>
                        <div class="display-6 fw-bold"><%= estadoMembresia.diasRestantes %></div>
                        <small>días restantes</small>
                    <% } else { %>
                        <span class="badge bg-light text-danger fs-6">Acércate a recepción para renovar</span>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Mis Clases Inscritas -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-bold">
                        <i class="bi bi-calendar-week text-primary"></i> Mis Clases Inscritas (<%= clases.length %>)
                    </div>
                    <div class="card-body">
                        <% if (clases.length === 0) { %>
                            <p class="text-muted small mb-0">No estás inscrito en ninguna clase grupal todavía.</p>
                        <% } else { %>
                            <ul class="list-group list-group-flush">
                                <% clases.forEach(c => { %>
                                    <li class="list-group-item px-0">
                                        <div class="d-flex justify-content-between">
                                            <strong><%= c.nombre_clase %></strong>
                                            <span class="badge bg-dark"><%= c.dia_semana %></span>
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-clock"></i> <%= c.hora_inicio.slice(0,5) %> - <%= c.hora_fin.slice(0,5) %> |
                                            Entrenador: <%= c.entrenador %>
                                        </small>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Mis Últimos Check-ins -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-bold">
                        <i class="bi bi-clock-history text-primary"></i> Mis Últimas Visitas
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha y Hora</th>
                                    <th>Estado</th>
                                    <th>Detalle</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (checkins.length === 0) { %>
                                    <tr><td colspan="3" class="text-center text-muted py-3">Sin visitas registradas aún.</td></tr>
                                <% } %>
                                <% checkins.forEach(ch => { %>
                                    <tr>
                                        <td><%= new Date(ch.fecha_hora).toLocaleString('es-HN') %></td>
                                        <td>
                                            <span class="badge <%= ch.acceso_permitido ? 'bg-success' : 'bg-danger' %>">
                                                <%= ch.acceso_permitido ? 'Permitido' : 'Denegado' %>
                                            </span>
                                        </td>
                                        <td class="small text-muted"><%= ch.detalle_estado %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Historial de Pagos y Vouchers PDF -->
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white fw-bold">
                        <i class="bi bi-receipt text-success"></i> Mi Historial de Pagos y Recibos
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Recibo</th>
                                    <th>Plan</th>
                                    <th>Fecha de Pago</th>
                                    <th>Vigencia</th>
                                    <th>Monto</th>
                                    <th class="text-end">Comprobante</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (pagos.length === 0) { %>
                                    <tr><td colspan="6" class="text-center text-muted py-3">No tienes pagos registrados.</td></tr>
                                <% } %>
                                <% pagos.forEach(p => { %>
                                    <tr>
                                        <td class="fw-bold"><%= p.codigo_recibo %></td>
                                        <td><%= p.nombre_plan %></td>
                                        <td><%= new Date(p.fecha_pago).toLocaleDateString('es-HN') %></td>
                                        <td class="small">
                                            <%= new Date(p.fecha_inicio).toLocaleDateString('es-HN') %> -
                                            <strong><%= new Date(p.fecha_vencimiento).toLocaleDateString('es-HN') %></strong>
                                        </td>
                                        <td class="fw-semibold">L. <%= parseFloat(p.monto_pagado).toFixed(2) %></td>
                                        <td class="text-end">
                                            <a href="/pagos/voucher/<%= p.id_pago %>" target="_blank" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-file-earmark-pdf-fill"></i> Ver PDF
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
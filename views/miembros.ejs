<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="mb-0"><i class="bi bi-people-fill text-primary"></i> Gestión de Miembros</h4>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoMiembro">
            <i class="bi bi-person-plus"></i> Nuevo Miembro
        </button>
    </div>

    <% if (mensaje) { %>
        <div class="alert alert-success alert-dismissible fade show py-2">
            <%= mensaje %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show py-2">
            <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Buscador por DNI o Nombre -->
    <form class="row g-2 mb-3" method="GET" action="/miembros">
        <div class="col-md-5">
            <input type="text" name="q" class="form-control" placeholder="Buscar por DNI o nombre..." value="<%= busqueda %>">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark"><i class="bi bi-search"></i> Buscar</button>
            <% if (busqueda) { %>
                <a href="/miembros" class="btn btn-outline-secondary">Limpiar</a>
            <% } %>
        </div>
    </form>

    <!-- Tabla responsiva -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>DNI</th>
                        <th>Nombre Completo</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (miembros.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No hay miembros registrados aún.</td>
                        </tr>
                    <% } %>
                    <% miembros.forEach(m => { %>
                        <tr>
                            <td class="fw-semibold"><%= m.dni %></td>
                            <td><%= m.nombre_completo %></td>
                            <td><%= m.telefono || '-' %></td>
                            <td><%= m.correo || '-' %></td>
                            <td>
                                <span class="badge <%= m.activo ? 'bg-success' : 'bg-secondary' %>">
                                    <%= m.activo ? 'Activo' : 'Inactivo' %>
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"
                                        data-id="<%= m.id_miembro %>"
                                        data-dni="<%= m.dni %>"
                                        data-nombre="<%= m.nombre_completo %>"
                                        data-telefono="<%= m.telefono || '' %>"
                                        data-correo="<%= m.correo || '' %>"
                                        onclick="abrirEditar(this)">
    <i class="bi bi-pencil"></i>
</button>
                                <form action="/miembros/estado/<%= m.id_miembro %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm <%= m.activo ? 'btn-outline-danger' : 'btn-outline-success' %>" title="Cambiar estado">
                                        <i class="bi <%= m.activo ? 'bi-person-x' : 'bi-person-check' %>"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nuevo Miembro -->
<div class="modal fade" id="modalNuevoMiembro" tabindex="-1">
    <div class="d-flex gap-2">
    <a href="/miembros/exportar-excel" class="btn btn-outline-success">
        <i class="bi bi-file-earmark-excel-fill"></i> Exportar Excel
    </a>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoMiembro">
        <i class="bi bi-person-plus"></i> Nuevo Miembro
    </button>
</div>
    <div class="modal-dialog">
        <form action="/miembros/crear" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Nuevo Miembro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">DNI  *</label>
                    <input type="text" name="dni" class="form-control" placeholder="0501-1999-00001" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombre Completo *</label>
                    <input type="text" name="nombre_completo" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <input type="text" name="telefono" class="form-control" placeholder="9999-9999">
                </div>
                <div class="mb-3">
                    <label class="form-label">Correo electrónico</label>
                    <input type="email" name="correo" class="form-control">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Miembro -->
<div class="modal fade" id="modalEditarMiembro" tabindex="-1">
    <div class="modal-dialog">
        <form id="formEditarMiembro" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Miembro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">DNI *</label>
                    <input type="text" id="edit_dni" name="dni" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombre Completo *</label>
                    <input type="text" id="edit_nombre" name="nombre_completo" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Telefono</label>
                    <input type="text" id="edit_telefono" name="telefono" class="form-control">
                </div>
                <div class="mb-3">
                    <label class="form-label">Correo electronico</label>
                    <input type="email" id="edit_correo" name="correo" class="form-control">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function abrirEditar(btn) {
    document.getElementById('formEditarMiembro').action = '/miembros/editar/' + btn.dataset.id;
    document.getElementById('edit_dni').value = btn.dataset.dni;
    document.getElementById('edit_nombre').value = btn.dataset.nombre;
    document.getElementById('edit_telefono').value = btn.dataset.telefono;
    document.getElementById('edit_correo').value = btn.dataset.correo;
    new bootstrap.Modal(document.getElementById('modalEditarMiembro')).show();
}
</script>
</body>
</html>
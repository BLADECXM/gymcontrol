<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="mb-0"><i class="bi bi-safe2 text-dark"></i> Control de Caja Diaria</h4>
        <button class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#modalMovimiento">
            <i class="bi bi-plus-circle"></i> Registrar Movimiento
        </button>
    </div>

    <% if (mensaje) { %>
        <div class="alert alert-success alert-dismissible fade show py-2">
            <%= mensaje %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show py-2">
            <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Tarjetas de Resumen / Arqueo de Hoy -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">Apertura de Caja</small>
                    <h5 class="fw-bold text-primary mb-0">L. <%= resumen.apertura %></h5>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">Cobros Efectivo + Extras</small>
                    <h5 class="fw-bold text-success mb-0">
                        L. <%= (parseFloat(resumen.cobrosEfectivo) + parseFloat(resumen.ingresosExtras)).toFixed(2) %>
                    </h5>
                    <small class="text-muted" style="font-size: 0.75rem;">
                        Membresías: L. <%= resumen.cobrosEfectivo %>
                    </small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">Egresos (Caja Chica)</small>
                    <h5 class="fw-bold text-danger mb-0">L. <%= resumen.egresos %></h5>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm bg-dark text-white h-100">
                <div class="card-body">
                    <small class="text-white-50">Efectivo Esperado</small>
                    <h5 class="fw-bold text-warning mb-0">L. <%= resumen.saldoEsperado %></h5>
                    <% if (resumen.ultimoCierre !== null) { %>
                        <small class="text-info" style="font-size: 0.75rem;">
                            Último cierre: L. <%= resumen.ultimoCierre %>
                        </small>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Movimientos de Hoy -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white fw-bold">
            <i class="bi bi-list-ul"></i> Movimientos registrados hoy (<%= movimientos.length %>)
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Hora</th>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Monto</th>
                        <th>Registrado por</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (movimientos.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No hay movimientos de caja registrados hoy. Comienza registrando la Apertura.
                            </td>
                        </tr>
                    <% } %>
                    <% movimientos.forEach(m => { %>
                        <tr>
                            <td><%= new Date(m.fecha_hora).toLocaleTimeString('es-HN', { hour: '2-digit', minute: '2-digit' }) %></td>
                            <td>
                                <% let badgeClass = 'bg-secondary'; %>
                                <% if (m.tipo_movimiento === 'APERTURA') badgeClass = 'bg-primary'; %>
                                <% if (m.tipo_movimiento === 'INGRESO') badgeClass = 'bg-success'; %>
                                <% if (m.tipo_movimiento === 'EGRESO') badgeClass = 'bg-danger'; %>
                                <% if (m.tipo_movimiento === 'CIERRE') badgeClass = 'bg-dark'; %>
                                <span class="badge <%= badgeClass %>"><%= m.tipo_movimiento %></span>
                            </td>
                            <td><%= m.descripcion %></td>
                            <td class="fw-semibold">L. <%= parseFloat(m.monto).toFixed(2) %></td>
                            <td class="small text-muted"><%= m.usuario_nombre %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Registrar Movimiento -->
<div class="modal fade" id="modalMovimiento" tabindex="-1">
    <div class="modal-dialog">
        <form action="/caja/movimiento" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Movimiento de Caja</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Tipo de Movimiento *</label>
                    <select name="tipo_movimiento" class="form-select" required>
                        <option value="APERTURA">APERTURA (Inicio de efectivo)</option>
                        <option value="INGRESO">INGRESO (Venta agua / extra)</option>
                        <option value="EGRESO">EGRESO (Gasto de caja chica)</option>
                        <option value="CIERRE">CIERRE (Arqueo final de turno)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Monto en Lempiras (L.) *</label>
                    <input type="number" step="0.01" min="0" name="monto" class="form-control" placeholder="0.00" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción / Concepto *</label>
                    <input type="text" name="descripcion" class="form-control" placeholder="Ej: Fondo inicial de caja / Compra de agua" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-dark">Guardar Movimiento</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
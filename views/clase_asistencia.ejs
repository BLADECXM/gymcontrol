<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0"><i class="bi bi-list-check text-primary"></i> <%= clase.nombre_clase %></h4>
            <small class="text-muted">
                <%= clase.dia_semana %> | <%= clase.hora_inicio.slice(0,5) %> - <%= clase.hora_fin.slice(0,5) %> |
                Entrenador: <strong><%= clase.entrenador_nombre %></strong>
            </small>
        </div>
        <a href="/clases" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Volver a Clases
        </a>
    </div>

    <% if (mensaje) { %>
        <div class="alert alert-success alert-dismissible fade show py-2">
            <%= mensaje %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show py-2">
            <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white fw-bold">
            Lista de Asistencia de Hoy (<%= new Date().toLocaleDateString('es-HN') %>)
        </div>

        <form action="/clases/<%= clase.id_clase %>/asistencia" method="POST">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>DNI</th>
                            <th>Atleta</th>
                            <th>Teléfono</th>
                            <th class="text-center">Asistió Hoy</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (inscritos.length === 0) { %>
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    No hay atletas inscritos en esta clase todavía.
                                </td>
                            </tr>
                        <% } %>
                        <% inscritos.forEach(a => { %>
                            <tr>
                                <td class="fw-semibold"><%= a.dni %></td>
                                <td><%= a.nombre_completo %></td>
                                <td><%= a.telefono || '-' %></td>
                                <td class="text-center">
                                    <input class="form-check-input" type="checkbox" name="presentes"
                                        value="<%= a.id_miembro %>" style="transform: scale(1.3);"
                                        <%= a.asistio_hoy ? 'checked' : '' %>
                                        <%= (usuario.rol === 'Recepcionista') ? 'disabled' : '' %>>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <% if (inscritos.length > 0 && (usuario.rol === 'Administrador' || usuario.rol === 'Entrenador')) { %>
                <div class="card-footer bg-white text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Asistencia
                    </button>
                </div>
            <% } %>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>